# Minimal SELinux policy for the first LineageOS 16.0 (Android 9) boot on j23g.
#
# Only declarations are kept here: the types that file_contexts / property_contexts /
# genfs_contexts refer to, plus the few domains started from init rc files.
# The old CM-era allow rules (they refer to types that do not exist in Android 9 and
# trip Android 9 neverallow rules) are parked in device/samsung/scx35-common/legacy_14.1/sepolicy/.
# Boot with androidboot.selinux=permissive (see board/kernel.mk) and port the rules back
# from the audit log (dmesg | grep avc) once the system boots.

# --- block / char devices
type efs_block_device, dev_type;
type prod_block_device, dev_type;
type radio_block_device, dev_type;
type param_block_device, dev_type;
type rfkill_device, dev_type;
type media_device, dev_type;
type bluetooth_serial_device, dev_type;
type gadget_serial_device, dev_type;
type gps_serial_device, dev_type;

# --- files
type prod_file, file_type;
type proc_pin_switch, fs_type, proc_type;
type proc_cpw, fs_type, proc_type;
type proc_cpt, fs_type, proc_type;
type sysfs_restart_cpc, fs_type, sysfs_type;
type sysfs_dynamic_pclk, fs_type, sysfs_type;

# --- properties
type media_prop, property_type;
type ctl_engpc_prop, property_type;

# --- daemons started from init rc
type engpc, domain;
type engpc_exec, exec_type, file_type;
init_daemon_domain(engpc)

type macloader, domain;
type macloader_exec, exec_type, file_type;
init_daemon_domain(macloader)

# --- types that existed in CM 14.1 policy but not in Android 9, still used by file_contexts
type gpsd, domain;
type gpsd_exec, exec_type, file_type;
init_daemon_domain(gpsd)
type gps_data_file, file_type, data_file_type, core_data_file_type;
